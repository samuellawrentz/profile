---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import LiquidEther from '../components/LiquidEther.jsx';
import { getCollection } from 'astro:content';
import { formatDate } from '../utils/blog';

const allBlogPosts = await getCollection('blog', ({ data }) => data.published === true);
const sorted = allBlogPosts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
const featured = sorted[0];
const recentPosts = sorted.slice(1, 6);

const allHacks = await getCollection('hacks', ({ data }) => data.published === true);
const hackCategories = ['react', 'neovim', 'philosophy', 'microfrontend', 'software-philosophy'];
const hackCounts = Object.fromEntries(
  hackCategories.map((c) => [c, allHacks.filter((h) => h.data.path?.startsWith(`/hacks/${c}/`)).length])
);

const projects = [
  { title: 'kron', what: 'Cron, but it actually tells you what happened. Output capture, run history, failure tracking.', link: 'https://krontab.xyz/', wide: true },
  { title: 'clipssh', what: 'Send clipboard screenshots to remote SSH hosts.', link: 'https://github.com/samuellawrentz/clipssh' },
  { title: 'jira-commit-helper', what: 'VSCode extension that puts JIRA ids into commits.', link: 'https://marketplace.visualstudio.com/items?itemName=samuellawrentz.jira-commit-helper' },
  { title: 'quotes-generator', what: 'Browser image quote generator with Unsplash backgrounds.', link: '/projects/quotes-generator/' },
  { title: 'react-highlight-textbox', what: 'Highlight patterns inside a text input in real time.', link: 'https://www.npmjs.com/package/react-highlight-textbox' },
  { title: 'rc-json-editor', what: 'Lightweight, dependency-free JSON editor for React.', link: 'https://www.npmjs.com/package/rc-json-editor' },
  { title: 'pasttenser', what: 'A tiny API that returns the past tense of any English verb.', link: '/projects/pasttenser/' },
];

const socials = [
  { k: 'github', href: 'https://github.com/samuellawrentz', label: '@samuellawrentz' },
  { k: 'linkedin', href: 'https://in.linkedin.com/in/samuel-lawrentz', label: 'samuel-lawrentz' },
  { k: 'twitter', href: 'https://twitter.com/samuellawrentz', label: '@samuellawrentz' },
  { k: 'codepen', href: 'https://codepen.io/samuellawrentz', label: 'samuellawrentz' },
];

const fileName = (p?: string) => `${(p ?? '').replace(/\/+$/, '').split('/').filter(Boolean).pop() ?? 'post'}.md`;

// staggered reveal counter for the hero
let r = 0;
const next = () => r++;
---

<BaseLayout
  title="Samuel Lawrentz - Design × Code × Systems"
  description="Samuel Lawrentz - Engineer and team lead building pixel-perfect UIs and end-to-end systems. Writing about React, TypeScript, CSS, and the craft of software."
>
  <SEO
    slot="head"
    title="Samuel Lawrentz - Design × Code × Systems"
    description="Samuel Lawrentz - Engineer and team lead building pixel-perfect UIs and end-to-end systems. Writing about React, TypeScript, CSS, and the craft of software."
  />

  <div class="lp" data-home-canvas>
    <!-- ── Hero: liquid-ether fluid sim behind the copy ── -->
    <section class="hero">
      <div class="hero__fluid" aria-hidden="true">
        <LiquidEther
          client:media="(prefers-reduced-motion: no-preference)"
          colors={['#E11D48', '#FF9FBC', '#B497CF']}
          mouseForce={18}
          cursorSize={110}
          resolution={0.5}
          autoDemo={true}
          autoSpeed={0.5}
          autoIntensity={2.0}
          autoResumeDelay={3000}
        />
      </div>
      <div class="hero__inner">
        <p class="hero__eyebrow rv" style={`--r:${next()}`}>
          <span class="hero__pulse" aria-hidden="true"></span>
          Samuel Lawrentz · engineer &amp; team lead · 9+ years
        </p>
        <h1 class="hero__title rv" style={`--r:${next()}`}>
          I build interfaces,<br />systems, and teams.
        </h1>
        <p class="hero__sub rv" style={`--r:${next()}`}>
          Nine years of shipping pixel-perfect UIs and the systems behind them.
          I write monthly about the craft - code, tools, and leading engineers.
        </p>
        <div class="hero__cta rv" style={`--r:${next()}`}>
          <a href="/blog/" class="btn btn--fill">Read the writing<span aria-hidden="true"> →</span></a>
          <a href="https://github.com/samuellawrentz" target="_blank" rel="noreferrer" class="btn btn--ghost">GitHub<span aria-hidden="true"> ↗</span></a>
        </div>
      </div>
    </section>

    <!-- ── Featured post, framed like a product panel ── -->
    {featured && (
      <section class="feat rv" style={`--r:${next()}`}>
        <a href={featured.data.path} class="feat__panel card">
          <div class="feat__chrome" aria-hidden="true">
            <span class="feat__dots"><i></i><i></i><i></i></span>
            <span class="feat__file">{fileName(featured.data.path)}</span>
            <span class="feat__badge">latest</span>
          </div>
          <div class="feat__body">
            <p class="feat__meta">{formatDate(featured.data.date)}</p>
            <h2 class="feat__title">{featured.data.title}</h2>
            {featured.data.description && <p class="feat__desc">{featured.data.description}</p>}
            <p class="feat__read">Read post<span aria-hidden="true"> →</span></p>
          </div>
        </a>
      </section>
    )}

    <!-- ── Writing ── -->
    <section class="sec" data-reveal>
      <header class="sec__head">
        <h2 class="sec__label">Writing</h2>
        <a href="/blog/" class="sec__more">All posts<span aria-hidden="true"> →</span></a>
      </header>
      <ul class="posts">
        {recentPosts.map((post) => (
          <li>
            <a href={post.data.path} class="post">
              <span class="post__date">{formatDate(post.data.date)}</span>
              <span class="post__title">{post.data.title}</span>
              <span class="post__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- ── Projects ── -->
    <section class="sec" data-reveal>
      <header class="sec__head">
        <h2 class="sec__label">Projects</h2>
        <a href="https://github.com/samuellawrentz" target="_blank" rel="noreferrer" class="sec__more">GitHub<span aria-hidden="true"> ↗</span></a>
      </header>
      <div class="grid">
        {projects.map((p) => (
          <a
            href={p.link}
            target={p.link.startsWith('http') ? '_blank' : '_self'}
            rel="noreferrer"
            class:list={['card', 'proj', { 'proj--wide': p.wide }]}
          >
            <h3 class="proj__name">{p.title}</h3>
            <p class="proj__what">{p.what}</p>
            <span class="proj__arrow" aria-hidden="true">{p.link.startsWith('http') ? '↗' : '→'}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- ── Hacks ── -->
    <section class="sec" data-reveal>
      <header class="sec__head">
        <h2 class="sec__label">Hacks</h2>
        <a href="/hacks/" class="sec__more">Browse all<span aria-hidden="true"> →</span></a>
      </header>
      <div class="chips">
        {hackCategories.map((cat) => (
          <a href={`/hacks/${cat}/`} class="card chip">
            <span class="chip__name">{cat}/</span>
            <span class="chip__count">{hackCounts[cat]}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- ── Footer strip ── -->
    <footer class="strip" data-reveal>
      <nav class="strip__links" aria-label="Social links">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noreferrer">{s.k}<span aria-hidden="true"> ↗</span></a>
        ))}
        <a href="/about/">about<span aria-hidden="true"> →</span></a>
        <a href="/rss.xml">rss<span aria-hidden="true"> ↗</span></a>
      </nav>
      <p class="strip__sig"><span class="strip__ok" aria-hidden="true">✓</span> main · updated monthly</p>
    </footer>
  </div>
</BaseLayout>

<script>
  // Spotlight-follows-cursor on cards (single listener, CSS vars)
  const cards = [...document.querySelectorAll<HTMLElement>('.card')];
  if (cards.length && matchMedia('(pointer: fine)').matches) {
    addEventListener(
      'pointermove',
      (e) => {
        for (const c of cards) {
          const rect = c.getBoundingClientRect();
          c.style.setProperty('--mx', `${e.clientX - rect.left}px`);
          c.style.setProperty('--my', `${e.clientY - rect.top}px`);
        }
      },
      { passive: true }
    );
  }

  // Below-the-fold sections: fade-up once when they enter.
  // Visible by default; the hidden state is only applied when JS will animate.
  const sections = [...document.querySelectorAll('[data-reveal]')];
  if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const en of entries) {
          if (en.isIntersecting) {
            en.target.classList.add('in');
            io.unobserve(en.target);
          }
        }
      },
      { rootMargin: '0px 0px -10% 0px' }
    );
    sections.forEach((s) => {
      s.classList.add('pre');
      io.observe(s);
    });
  }
</script>

<style is:global>
  /* Homepage owns its canvas: darker than the site-wide surface1 in dark
     mode (Linear-style near-black), warm paper in light mode. */
  [color-mode='dark'] body:has([data-home-canvas]) {
    background-color: hsl(240, 8%, 5%);
  }
  [color-mode='light'] body:has([data-home-canvas]) {
    background-color: hsl(42, 30%, 97%);
  }
  /* the full-bleed fluid layer is 100vw wide; don't let it cause h-scroll */
  body:has([data-home-canvas]) {
    overflow-x: hidden;
  }
</style>

<style lang="scss">
  /* ───────── Linear-grade landing ─────────
     Self-contained tokens (homepage does not use IdeWindow). */
  .lp {
    /* light theme: warm paper, hairlines via ink alpha, tinted shadows */
    --canvas: hsl(42, 30%, 97%);
    --s1: hsl(40, 30%, 99%);
    --s2: hsl(42, 25%, 96%);
    --line: hsla(30, 25%, 12%, 0.1);
    --line-strong: hsla(30, 25%, 12%, 0.18);
    --text: hsl(30, 10%, 10%);
    --text-2: hsla(30, 10%, 10%, 0.64);
    --text-3: hsla(30, 10%, 10%, 0.42);
    --accent: hsl(349, 85%, 40%);
    --accent-text: hsl(349, 85%, 38%);
    --spot: hsla(349, 85%, 45%, 0.05);
    --top-light: hsla(0, 0%, 100%, 0.9);
    --card-shadow: 0 1px 2px hsla(345, 40%, 15%, 0.05), 0 8px 24px hsla(345, 40%, 15%, 0.05);

    position: relative;
    max-width: 1080px;
    margin: 0 auto;
    padding: 40px 24px 64px;
    font-family: 'IBM Plex Sans', sans-serif;
    color: var(--text);
  }

  :global([color-mode='dark']) .lp {
    /* dark theme: surface ladder, translucent-white hairlines, one glow */
    --canvas: hsl(240, 8%, 5%);
    --s1: hsl(240, 7%, 8%);
    --s2: hsl(240, 6%, 11%);
    --line: hsla(0, 0%, 100%, 0.08);
    --line-strong: hsla(0, 0%, 100%, 0.16);
    --text: hsla(228, 20%, 95%, 0.92);
    --text-2: hsla(228, 15%, 90%, 0.6);
    --text-3: hsla(228, 15%, 90%, 0.38);
    --accent: hsl(349, 80%, 48%);
    --accent-text: hsl(350, 90%, 68%);
    --spot: hsla(350, 90%, 60%, 0.07);
    --top-light: hsla(0, 0%, 100%, 0.1);
    --card-shadow: none;
  }

  /* ── hero: fluid sim full-bleed behind centered copy ── */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: clamp(520px, 76vh, 860px);
    padding: 48px 0 88px;
    text-align: center;
  }

  .hero__fluid {
    position: absolute;
    top: -40px; /* cover the .lp top padding, up to the header */
    bottom: -32px;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    z-index: 0;

    /* dissolve into the canvas at both edges (under the header, before the featured panel) */
    &::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, var(--canvas), transparent 22%, transparent 55%, var(--canvas) 97%);
      pointer-events: none;
    }
  }

  :global([color-mode='light']) .hero__fluid { opacity: 0.55; }

  .hero__inner {
    position: relative;
    z-index: 1;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 28px;
    padding: 6px 14px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--text-2);
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--s1) 60%, transparent);
  }

  .hero__pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-text);
    box-shadow: 0 0 8px var(--accent-text);
  }

  .hero__title {
    margin: 0 0 24px;
    font-family: 'Sora', sans-serif;
    font-weight: 700;
    font-size: clamp(44px, 7.6vw, 84px);
    line-height: 1.03;
    letter-spacing: -0.045em;
    text-shadow: none; /* override global h1 emboss */
  }

  .hero__sub {
    max-width: 52ch;
    margin: 0 auto 36px;
    font-size: 18px;
    line-height: 1.65;
    color: var(--text-2);
  }

  .hero__cta {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 10px 20px;
    border-radius: 8px;
    font-size: 14.5px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.18s, color 0.18s, border-color 0.18s;

    &:active { transform: scale(0.98); }
  }

  .btn--fill {
    background: var(--accent);
    color: hsl(0, 0%, 100%);
    box-shadow: inset 0 1px 0 hsla(0, 0%, 100%, 0.18);

    &:hover { background: color-mix(in srgb, var(--accent) 88%, hsl(0, 0%, 100%)); }
  }

  .btn--ghost {
    color: var(--text-2);
    border: 1px solid var(--line-strong);

    &:hover { color: var(--text); border-color: var(--text-3); }
  }

  /* ── shared card: hairline border, top light line, cursor spotlight ── */
  .card {
    position: relative;
    display: block;
    background: var(--s1);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: inset 0 1px 0 var(--top-light), var(--card-shadow);
    text-decoration: none;
    color: var(--text);
    overflow: hidden;
    transition: border-color 0.2s;

    &::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(280px circle at var(--mx, 50%) var(--my, 50%), var(--spot), transparent 70%);
      opacity: 0;
      transition: opacity 0.25s;
      pointer-events: none;
    }

    &:hover {
      border-color: var(--line-strong);
      &::before { opacity: 1; }
    }
  }

  /* ── featured panel ── */
  .feat { margin-bottom: 96px; }

  .feat__panel {
    max-width: 720px;
    margin: 0 auto;
    border-radius: 16px;
  }

  .feat__chrome {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--line);
    background: var(--s2);
  }

  .feat__dots {
    display: inline-flex;
    gap: 6px;

    i {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--line-strong);
    }
  }

  .feat__file {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--text-3);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .feat__badge {
    margin-left: auto;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent-text);
    border: 1px solid color-mix(in srgb, var(--accent-text) 35%, transparent);
    border-radius: 999px;
    padding: 3px 10px;
  }

  .feat__body { padding: 30px 34px 32px; }

  .feat__meta {
    margin: 0 0 10px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--text-3);
  }

  .feat__title {
    margin: 0 0 12px;
    font-family: 'Sora', sans-serif;
    font-weight: 600;
    font-size: clamp(22px, 3.4vw, 30px);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .feat__desc {
    margin: 0 0 20px;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--text-2);
  }

  .feat__read {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-text);
  }

  /* ── sections ── */
  .sec { margin-bottom: 96px; }

  .sec__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 14px;
    margin-bottom: 22px;
    border-bottom: 1px solid var(--line);
  }

  .sec__label {
    margin: 0;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 500;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--text-3);
  }

  .sec__more {
    font-size: 13px;
    color: var(--text-2);
    text-decoration: none;
    transition: color 0.18s;

    &:hover { color: var(--accent-text); }
  }

  /* ── writing rows ── */
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 20px;
    padding: 14px 10px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--text);
    transition: background 0.16s;

    &:hover {
      background: var(--s2);

      .post__title { color: var(--accent-text); }
      .post__arrow { opacity: 1; transform: translateX(0); }
    }
  }

  li + li .post { border-top: 1px solid var(--line); }

  .post__date {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--text-3);
    white-space: nowrap;
  }

  .post__title {
    font-size: 15.5px;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 0.18s;
  }

  .post__arrow {
    color: var(--accent-text);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.18s, transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* ── projects grid ── */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .proj {
    padding: 22px 22px 20px;

    &--wide { grid-column: span 2; }
  }

  .proj__name {
    margin: 0 0 8px;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 14.5px;
    letter-spacing: -0.01em;
  }

  .proj__what {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-2);
  }

  .proj__arrow {
    position: absolute;
    top: 18px;
    right: 18px;
    font-size: 13px;
    color: var(--text-3);
    transition: color 0.18s;
  }

  .proj:hover .proj__arrow { color: var(--accent-text); }

  /* ── hacks chips ── */
  .chips {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 14px;
  }

  .chip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 16px 18px;
  }

  .chip__name {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13.5px;
    font-weight: 500;
  }

  .chip__count {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--text-3);
  }

  /* ── footer strip ── */
  .strip {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  .strip__links {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;

    a {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12.5px;
      color: var(--text-2);
      text-decoration: none;
      transition: color 0.18s;

      &:hover { color: var(--accent-text); }
    }
  }

  .strip__sig {
    margin: 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--text-3);
  }

  .strip__ok { color: var(--accent-text); }

  /* ── motion: staggered blur+fade on load (hero), fade-up on scroll ── */
  .rv {
    opacity: 0;
    animation: rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--r, 0) * 0.1s);
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(16px); filter: blur(6px); }
    to { opacity: 1; transform: translateY(0); filter: blur(0); }
  }

  [data-reveal]:global(.pre) {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-reveal]:global(.pre.in) { opacity: 1; transform: translateY(0); }

  @media (prefers-reduced-motion: reduce) {
    .rv { animation: none; opacity: 1; }
    [data-reveal] { opacity: 1; transform: none; transition: none; }
    .card::before { display: none; }
  }

  /* ── responsive ── */
  @media (max-width: 760px) {
    .hero { padding: 40px 0 64px; min-height: clamp(420px, 68svh, 700px); }
    .feat { margin-bottom: 72px; }
    .sec { margin-bottom: 72px; }
    .feat__body { padding: 24px 22px 26px; }
    .grid { grid-template-columns: 1fr 1fr; }
    .proj--wide { grid-column: span 2; }
  }

  @media (max-width: 540px) {
    .grid { grid-template-columns: 1fr; }
